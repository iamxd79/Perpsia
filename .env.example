OPENAI_API_KEY=
PERPSIA_ENABLE_OPENAI_SIGNAL_VALIDATION=true
OPENAI_SIGNAL_MODEL=gpt-5.5
OPENAI_SIGNAL_TIMEOUT_MS=12000

# Never commit real credentials. Local development may leave optional values blank.
ALCHEMY_ENABLED=false
ALCHEMY_API_KEY=
ALCHEMY_TIMEOUT_MS=8000
ALCHEMY_NETWORKS=ethereum,base,arbitrum,bnb,polygon
ALCHEMY_WEBHOOK_SIGNING_KEY=
# Optional Notify API token and callback URL for automatic canonical-wallet sync.
ALCHEMY_NOTIFY_AUTH_TOKEN=
ALCHEMY_WEBHOOK_URL=
ALCHEMY_SYNC_INTERVAL_MS=900000

# GMGN read-only research provider. Never add GMGN_PRIVATE_KEY here.
GMGN_ENABLED=false
GMGN_API_KEY=
GMGN_TIMEOUT_MS=8000
GMGN_DEFAULT_CHAIN=sol
GMGN_SMART_MONEY_LIMIT=100

# Optional scheduled canonical-wallet refresh. Manual CLI refresh is always available.
PERPSIA_WALLET_REFRESH_ENABLED=false
PERPSIA_GMGN_REFRESH_INTERVAL_MS=21600000
PERPSIA_GMGN_REFRESH_CHAINS=sol,ethereum
PERPSIA_WALLET_QUALITY_LOW=40
PERPSIA_WALLET_QUALITY_WATCH=60
PERPSIA_WALLET_QUALITY_QUALITY=75
PERPSIA_WALLET_QUALITY_HIGH=90
PERPSIA_MAX_ALCHEMY_WATCHED_ADDRESSES=
PERPSIA_WALLET_MIN_SYNC_PRIORITY=0

# Existing ONCHAIN architecture. JSON values are server-side only.
ONCHAIN_PRICE_ENDPOINT=
ONCHAIN_ASSET_REGISTRY=
ONCHAIN_EXCHANGE_ADDRESSES=
ONCHAIN_RPC_URLS=

# Render persistent disk (set only in production)
PERPSIA_DB_PATH=/var/data/perpsia.db

# PostgreSQL/Supabase migration boundary. Keep empty while SQLite remains active.
PERPSIA_DATABASE_URL=
SUPABASE_DB_URL=
PERPSIA_DATABASE_SSL=true
PERPSIA_DATABASE_POOL_SIZE=5

# Protect internal metrics, signal-quality, and detailed-trades endpoints.
# Use the same value as PERPSIA_API_TOKEN on the landing deployment.
PERPSIA_INTERNAL_API_TOKEN=
PERPSIA_TELEGRAM_LOCK_TTL_MS=120000

# Maximum ranked candidates analyzed per market scan.
PERPSIA_MAX_SCAN_CANDIDATES=54
# Maximum data-complete candidates sent to Grok/OpenAI for secondary validation.
# Set to 0 to keep model validation disabled without changing provider keys.
PERPSIA_AI_VALIDATION_CANDIDATES=12
# Public PerpsIA dashboard URL used by secure one-time Telegram account links.
PERPSIA_APP_URL=https://www.perpsia.app
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
