# Never commit real credentials. Local development may leave optional values blank.
ALCHEMY_ENABLED=false
ALCHEMY_API_KEY=
ALCHEMY_TIMEOUT_MS=8000
ALCHEMY_NETWORKS=ethereum,base,arbitrum,bnb,polygon
ALCHEMY_WEBHOOK_SIGNING_KEY=

# GMGN read-only research provider. Never add GMGN_PRIVATE_KEY here.
GMGN_ENABLED=false
GMGN_API_KEY=
GMGN_TIMEOUT_MS=8000

# Existing ONCHAIN architecture. JSON values are server-side only.
ONCHAIN_PRICE_ENDPOINT=
ONCHAIN_ASSET_REGISTRY=
ONCHAIN_EXCHANGE_ADDRESSES=
ONCHAIN_RPC_URLS=

# Render persistent disk (set only in production)
PERPSIA_DB_PATH=/var/data/perpsia.db
